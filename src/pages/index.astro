---
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPublishedPosts, getTagCounts } from '../utils/posts';
import { SITE } from '../consts';

const posts = await getPublishedPosts();
const featured = posts.filter((post) => post.data.featured);
const picked = (featured.length > 0 ? featured : posts.slice(0, 2)).slice(0, 3);
const pickedIds = new Set(picked.map((post) => post.id));
const recentPool = posts.filter((post) => !pickedIds.has(post.id));
const recent = (recentPool.length > 0 ? recentPool : posts).slice(0, 6);
const topics = getTagCounts(posts).slice(0, 8);

const name = SITE.author.trim();
const accentChar = name.charAt(0);
const restName = name.slice(1);
const portraitFile = ['jpg', 'jpeg', 'webp', 'png']
  .map((ext) => `portrait.${ext}`)
  .find((file) => existsSync(fileURLToPath(new URL(`../../public/${file}`, import.meta.url))));

const topicTones = [
  'from-sky-500 to-blue-900',
  'from-cyan-600 to-slate-900',
  'from-sky-700 to-indigo-950',
  'from-teal-500 to-sky-950',
  'from-blue-500 to-cyan-900',
];
---

<BaseLayout contained={false}>
  <section class="relative overflow-hidden bg-hero text-white">
    <div class="pointer-events-none absolute top-24 right-[18%] size-16 rounded-full bg-sky-500/30 blur-sm"></div>
    <div class="pointer-events-none absolute top-40 right-[8%] text-4xl font-light text-sky-300/80">+</div>
    <div class="mx-auto grid w-full max-w-6xl items-center gap-10 px-6 pt-32 pb-36 lg:grid-cols-[1.1fr_0.9fr] lg:pt-36">
      <div>
        <p class="text-sm font-semibold text-sky-200">{SITE.greeting}</p>
        <h1 class="mt-4 text-5xl font-extrabold tracking-tight sm:text-7xl">
          I'm <span class="text-accent-light">{accentChar}</span>{restName}
        </h1>
        <p class="mt-6 max-w-xl text-base leading-relaxed text-slate-300 sm:text-lg">{SITE.description}</p>
        <div id="subscribe" class="mt-8 max-w-md">
          <form id="subscribe-form" class="flex items-center gap-2 rounded-full border border-white/15 bg-white/10 p-1.5">
            <label class="sr-only" for="subscribe-email">Email</label>
            <input
              id="subscribe-email"
              type="email"
              name="email"
              required
              placeholder="Nhập email của bạn"
              class="min-w-0 flex-1 bg-transparent px-4 py-2 text-sm text-white outline-none placeholder:text-white/50"
            />
            <button type="submit" class="shrink-0 rounded-full bg-accent px-5 py-2.5 text-sm font-semibold text-white hover:bg-accent-light">
              Theo dõi
            </button>
          </form>
          <p id="subscribe-thanks" hidden class="mt-3 text-sm text-sky-200">
            Cảm ơn bạn. Email chỉ được ghi trên trang này, chưa gửi đi đâu.
          </p>
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-md">
        {
          portraitFile ? (
            <img
              src={`/${portraitFile}`}
              alt=""
              class="relative z-10 mx-auto max-h-[460px] w-auto object-contain"
              width="480"
              height="560"
            />
          ) : (
            <svg viewBox="0 0 420 480" class="relative z-10 mx-auto w-full max-w-sm" role="img" aria-label="Minh họa trang trí">
              <ellipse cx="210" cy="430" rx="120" ry="18" fill="#0ea5e9" opacity="0.18" />
              <circle cx="210" cy="168" r="72" fill="#12304f" />
              <path d="M120 250c18-46 52-70 90-70s72 24 90 70l28 150H92Z" fill="#0e7490" />
              <path d="M150 300c20 36 40 70 60 92 20-22 40-56 60-92 8 48-10 110-60 140-50-30-68-92-60-140Z" fill="#155e75" />
              <rect x="168" y="248" width="84" height="10" rx="5" fill="#e2e8f0" opacity="0.85" />
              <circle cx="186" cy="162" r="6" fill="#e2e8f0" />
              <circle cx="234" cy="162" r="6" fill="#e2e8f0" />
              <path d="M196 188c8 8 20 8 28 0" fill="none" stroke="#e2e8f0" stroke-width="4" stroke-linecap="round" />
              <path d="M78 120l18 10-18 10-18-10Z" fill="#38bdf8" />
              <circle cx="330" cy="250" r="14" fill="#0ea5e9" />
              <circle cx="86" cy="280" r="8" fill="#38bdf8" />
              <path d="M318 96l8 14h-16Z" fill="#7dd3fc" />
            </svg>
          )
        }
      </div>
    </div>
  </section>

  {
    topics.length > 0 && (
      <div class="relative z-10 -mt-24">
        <div class="mx-auto w-full max-w-6xl px-6">
          <div class="rounded-[28px] bg-hero-card p-6 text-white shadow-2xl sm:p-8">
            <div class="grid items-center gap-6 lg:grid-cols-[220px_1fr]">
              <div>
                <h2 class="text-2xl font-extrabold">Chủ đề nóng</h2>
                <p class="mt-2 text-sm leading-relaxed text-slate-300">
                  Những chuyên mục đang có nhiều trang viết nhất.
                </p>
                <div class="mt-4 flex gap-2">
                  <button
                    type="button"
                    class="grid size-9 place-items-center rounded-full bg-white/10 hover:bg-white/20"
                    data-topics="prev"
                    aria-label="Chủ đề trước"
                  >
                    &larr;
                  </button>
                  <button
                    type="button"
                    class="grid size-9 place-items-center rounded-full bg-white/10 hover:bg-white/20"
                    data-topics="next"
                    aria-label="Chủ đề sau"
                  >
                    &rarr;
                  </button>
                </div>
              </div>
              <div id="topics-track" class="topics-track flex snap-x gap-4 overflow-x-auto scroll-smooth">
                {topics.map(({ tag, slug, count }, index) => (
                  <a
                    href={`/tags/${slug}/`}
                    class:list={[
                      'flex h-44 w-44 shrink-0 snap-start flex-col justify-end rounded-2xl bg-gradient-to-br p-4 no-underline sm:w-52',
                      topicTones[index % topicTones.length],
                    ]}
                  >
                    <span class="text-lg font-bold text-white">{tag}</span>
                    <span class="text-sm text-white/80">{count} bài</span>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    )
  }

  {
    recent.length > 0 && (
      <section class="mx-auto w-full max-w-6xl px-6 py-16">
        <h2 class="text-4xl font-extrabold tracking-tight text-accent sm:text-5xl">Bài mới</h2>
        <p class="mt-2 text-ink-soft dark:text-cream-soft">Những trang vừa được viết.</p>
        <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {recent.map((post) => (
            <PostCard post={post} />
          ))}
        </div>
      </section>
    )
  }

  {
    picked.length > 0 && (
      <section class="mx-auto w-full max-w-6xl px-6 pb-20">
        <h2 class="text-4xl font-extrabold tracking-tight text-accent sm:text-5xl">Biên tập viên chọn</h2>
        <p class="mt-2 text-ink-soft dark:text-cream-soft">Những bài để đọc chậm.</p>
        <div class="mt-8 grid gap-6 md:grid-cols-2">
          {picked.map((post) => (
            <PostCard post={post} variant="picked" />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>

<script>
  const form = document.getElementById('subscribe-form');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    form.setAttribute('hidden', '');
    document.getElementById('subscribe-thanks')?.removeAttribute('hidden');
  });

  const track = document.getElementById('topics-track');
  document.querySelectorAll<HTMLButtonElement>('[data-topics]').forEach((button) => {
    button.addEventListener('click', () => {
      const amount = button.dataset.topics === 'next' ? 240 : -240;
      track?.scrollBy({ left: amount, behavior: 'smooth' });
    });
  });
</script>
