---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { getPublishedPosts, getTagCounts, slugifyTag } from '../../utils/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return getTagCounts(posts).map(({ tag, slug }) => ({
    params: { tag: slug },
    props: { tag, posts: posts.filter((p) => p.data.tags.some((t) => slugifyTag(t) === slug)) },
  }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout title={tag} description={`Những trang viết về ${tag.toLowerCase()}.`}>
  <SectionHeading kicker={`${posts.length} bài`} title={tag} />
  <div class="grid gap-6 sm:grid-cols-2">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
  <p class="mt-8">
    <a href="/tags/" class="text-sm font-semibold text-accent no-underline hover:text-ink dark:hover:text-cream">
      &larr; Tất cả chuyên mục
    </a>
  </p>
</BaseLayout>
