---
import { NAV_LINKS, SITE } from '../consts';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const overlay = path === '/';
const isActive = (href: string) => {
  if (href.includes('#')) return false;
  return href === '/' ? path === '/' : path.startsWith(href);
};
---

<header id="site-header" class:list={['site-header fixed inset-x-0 top-0 z-50', overlay && 'is-overlay']}>
  <div class="mx-auto flex h-20 w-full max-w-6xl items-center justify-between gap-4 px-6">
    <a href="/" class="flex min-w-0 items-center gap-2.5 no-underline" aria-label={SITE.title}>
      <svg viewBox="0 0 40 40" class="size-9 shrink-0" aria-hidden="true">
        <g fill="#38bdf8">
          <path d="M20 2 23.2 16.8 20 15 16.8 16.8Z"></path>
          <path d="M38 20 23.2 16.8 25 20 23.2 23.2Z"></path>
          <path d="M20 38 16.8 23.2 20 25 23.2 23.2Z"></path>
          <path d="M2 20 16.8 23.2 15 20 16.8 16.8Z"></path>
        </g>
        <circle cx="20" cy="20" r="2.6" fill="#0ea5e9"></circle>
      </svg>
      <span class="truncate text-lg font-extrabold tracking-tight sm:text-xl">{SITE.title}</span>
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Điều hướng chính">
      {
        NAV_LINKS.map(({ href, label }) => (
          <a
            href={href}
            class:list={[
              'text-sm font-semibold no-underline hover:text-accent',
              isActive(href) && 'text-accent',
            ]}
            aria-current={isActive(href) ? 'page' : undefined}
          >
            {label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1 sm:gap-2">
      <a href="/search/" class="grid size-10 place-items-center rounded-full no-underline hover:text-accent" aria-label="Tìm">
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="M20 20 16.5 16.5" stroke-linecap="round"></path>
        </svg>
      </a>
      <ThemeToggle />
      <a
        href="/#subscribe"
        class="hidden rounded-full bg-accent px-4 py-2 text-sm font-semibold text-white no-underline hover:bg-accent-light sm:inline-flex"
      >
        Theo dõi
      </a>
      <button
        id="nav-open"
        type="button"
        class="grid size-10 place-items-center rounded-full lg:hidden"
        aria-expanded="false"
        aria-controls="nav-drawer"
        aria-label="Mở menu"
      >
        <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<div id="nav-drawer" class="fixed inset-0 z-[60] hidden" hidden>
  <button type="button" class="absolute inset-0 bg-ink/40" data-close aria-label="Đóng menu"></button>
  <nav
    class="absolute inset-y-0 right-0 flex h-full w-full flex-col gap-1 bg-paper px-6 pt-6 text-ink shadow-2xl sm:w-80 dark:bg-night dark:text-cream"
    aria-label="Menu"
  >
    <button type="button" class="mb-4 self-end rounded-full px-3 py-2 text-sm font-semibold" data-close>Đóng</button>
    {
      NAV_LINKS.map(({ href, label }) => (
        <a
          href={href}
          class:list={[
            'rounded-2xl px-3 py-3 text-lg font-semibold no-underline hover:bg-paper-deep dark:hover:bg-night-deep',
            isActive(href) && 'text-accent',
          ]}
        >
          {label}
        </a>
      ))
    }
    <a href="/#subscribe" class="mt-4 rounded-full bg-accent px-4 py-3 text-center font-semibold text-white no-underline">
      Theo dõi
    </a>
  </nav>
</div>

<script>
  const header = document.getElementById('site-header');
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const drawer = document.getElementById('nav-drawer');
  const openBtn = document.getElementById('nav-open');
  const setOpen = (open: boolean) => {
    if (!drawer || !openBtn) return;
    drawer.classList.toggle('hidden', !open);
    drawer.toggleAttribute('hidden', !open);
    openBtn.setAttribute('aria-expanded', String(open));
    document.body.classList.toggle('overflow-hidden', open);
  };
  openBtn?.addEventListener('click', () => setOpen(true));
  drawer?.querySelectorAll('[data-close], a').forEach((el) => {
    el.addEventListener('click', () => setOpen(false));
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setOpen(false);
  });
</script>
