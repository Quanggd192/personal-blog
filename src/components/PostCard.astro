---
import { Image } from 'astro:assets';
import TagList from './TagList.astro';
import { formatCardDate, readingTime, type Post } from '../utils/posts';
import { SITE } from '../consts';

interface Props {
  post: Post;
  variant?: 'default' | 'picked';
}

const { post, variant = 'default' } = Astro.props;
const { title, description, pubDate, tags, draft, heroImage } = post.data;
const tones = [
  'from-sky-400 to-blue-800',
  'from-cyan-500 to-slate-800',
  'from-sky-600 to-indigo-900',
  'from-teal-400 to-sky-900',
];
const tone = tones[post.id.length % tones.length];
const initial = SITE.author.trim().charAt(0).toUpperCase();
---

<article class="group flex h-full flex-col rounded-[28px] bg-white p-3 shadow-sm ring-1 ring-rule dark:bg-night-deep dark:ring-night-rule">
  <a href={`/blog/${post.id}/`} class="relative block overflow-hidden rounded-[22px] no-underline" tabindex="-1" aria-hidden="true">
    {
      heroImage ? (
        <Image
          src={heroImage}
          alt=""
          class:list={['w-full object-cover', variant === 'picked' ? 'aspect-[16/10]' : 'aspect-[4/3]']}
        />
      ) : (
        <div class:list={['w-full bg-gradient-to-br', tone, variant === 'picked' ? 'aspect-[16/10]' : 'aspect-[4/3]']} />
      )
    }
  </a>
  <div class="flex flex-1 flex-col px-3 pt-4 pb-3">
    <div class="flex items-start justify-between gap-3">
      <TagList tags={tags.slice(0, 2)} />
      <span class="shrink-0 text-sm text-ink-faint dark:text-cream-faint">{readingTime(post.body)} phút đọc</span>
    </div>
    <h2 class:list={['mt-3 font-extrabold tracking-tight', variant === 'picked' ? 'text-2xl' : 'text-xl']}>
      <a href={`/blog/${post.id}/`} class="no-underline group-hover:text-accent">
        {title}
      </a>
    </h2>
    <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-ink-soft dark:text-cream-soft">{description}</p>
    {draft && <span class="mt-3 w-fit rounded-full bg-accent px-2 py-0.5 text-xs font-semibold text-white">Bản nháp</span>}
    <div class="mt-auto flex items-center gap-3 pt-5">
      <span class="grid size-10 place-items-center rounded-full bg-ink text-sm font-bold text-white dark:bg-cream dark:text-night">
        {initial}
      </span>
      <div>
        <p class="text-sm font-semibold">{SITE.author}</p>
        <time class="text-xs text-ink-faint dark:text-cream-faint" datetime={pubDate.toISOString()}>{formatCardDate(pubDate)}</time>
      </div>
    </div>
  </div>
</article>
